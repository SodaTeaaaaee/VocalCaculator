*.log
*.tmp
*.temp
*.bak
*.orig
*.stackdump
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Android / desktop release artifacts
*.apk
*.aab
*.apks
*.msix
*.msi
*.dmg
*.deb
*.rpm
/.gradle/
**/local.properties

# Project-local toolchains, SDKs, downloads, and machine state.
# Keep the checked-in helper scripts under .local/.
/.local/*
!/.local/*.cmd
!/.local/*.ps1

# Cloned reference repos used during development
.local/AR7778-digitized-MIDI/

# Agent / AI tooling (machine state, not source)
.agents/
.claude/
.omp/
.codex/
.gemini/
.continue/
.aider*
/terminals/

# Local language-tool leftovers (eval / notebooks / web extras)
__pycache__/
*.py[cod]
.ipynb_checkpoints/
/node_modules/

# Rust dependency snapshots are local-only unless we explicitly choose to vendor.
/vendor/

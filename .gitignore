/cobertura.xml
/lcov.info
/nextest/

# Editor / OS cruft
.idea/
.vscode/
.cursor/
.fleet/
.zed/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

